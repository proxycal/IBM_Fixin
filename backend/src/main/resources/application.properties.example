# Copy this file to application.properties and fill in your values
# OR set the environment variables directly (recommended for production)

# Groq API key (free at console.groq.com)
# Env var: GROQ_API_KEY
watsonx.api-key=YOUR_GROQ_API_KEY_HERE

# Groq model (default works fine)
# Env var: GROQ_MODEL_ID
watsonx.model-id=openai/gpt-oss-120b

# Context extractor character budget
context.char-limit=30000

# Build runner timeout
build.timeout-minutes=5

# Comma-separated allowed CORS origins
# Env var: CORS_ORIGIN
cors.allowed-origin=http://localhost:5173
